<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        com.mitchell.stack-ops.stray-drain

        Drains unwrapped Claude Code transcripts into vault session records at
        01:30 and 13:30 PT, half an hour ahead of nightly-hygiene.

        WHY IT IS SCHEDULED. /wrap captures only the current session. Historical
        extraction is mechanical and bounded, so it belongs on a schedule and not
        in an interactive model's context window.

        ROUTING. Structured extraction starts on the zero-data-retention cheap
        lane with automatic frontier escalation disabled. Eligible operational
        failures may advance through the approved subscription chain. Privacy,
        policy, input, and authorization failures stop and receive a bounded
        metadata-only disposition. No metered frontier fallback is permitted.

        SAFETY. Never deletes a transcript. Claims each through the locked wrap
        ledger before reading content so concurrent /wrap runs cannot double-mine.
        Commits only this run's validated session records with exact paths and
        `git commit --only`, because 10 to 30 concurrent sessions write this vault.

        The installed zsh entrypoint detaches Node through nohup because launchd
        jobs on macOS Tahoe flap when they run long work directly. Log paths live
        outside ~/Documents.

        Bootstrap:
          scripts/install-stray-drain-launchd.zsh

        Run by hand:
          node ~/Documents/stack-ops/scripts/memory-sweep/stray-drain.mjs --dry-run
    -->

    <key>Label</key>
    <string>com.mitchell.stack-ops.stray-drain</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>__STACK_OPS_RUNTIME_WRAPPER__</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__STACK_OPS_HOME__</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>

    <key>AbandonProcessGroup</key>
    <true/>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>1</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>13</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>__STACK_OPS_LOG_DIR__/launchd.out</string>

    <key>StandardErrorPath</key>
    <string>__STACK_OPS_LOG_DIR__/launchd.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__STACK_OPS_HOME__/.claude/bin:__STACK_OPS_HOME__/.nvm/versions/node/v24.14.0/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__STACK_OPS_HOME__</string>
    </dict>
</dict>
</plist>
