<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        com.mitchell.career-ops.dashboard-server-nohup-wrapper

        Workaround for the macOS Tahoe (15.x) launchd KeepAlive=true regression
        documented in ~/.claude/knowledge/brain/bug-class-catalog.md § Pattern F.
        The canonical dashboard-server plist is correct on disk but exits with
        EX_CONFIG (78) within milliseconds of every spawn attempt on Tahoe —
        before Node.js can even print to stdout. Mirrors the existing
        cloudflared-staging-nohup-wrapper.plist pattern.

        Fires at boot/login (RunAtLoad=true) and every 5 minutes (StartInterval),
        shells out to scripts/launchd/dashboard-server-nohup.sh which checks
        whether port 3097 is already occupied and if not, nohup-spawns
        dashboard-server.mjs into a detached session. The script is idempotent,
        so the 5-minute tick is safe to fire repeatedly.

        REMOVE this wrapper when Apple patches the launchd KeepAlive bug and a
        clean `launchctl bootstrap` on the canonical plist works again.

        Bootstrap:
            cp scripts/launchd/com.mitchell.career-ops.dashboard-server-nohup-wrapper.plist \
               ~/Library/LaunchAgents/
            launchctl bootstrap gui/$(id -u) \
                ~/Library/LaunchAgents/com.mitchell.career-ops.dashboard-server-nohup-wrapper.plist
    -->

    <key>Label</key>
    <string>com.mitchell.career-ops.dashboard-server-nohup-wrapper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mitchellwilliams/.local/career-ops-wrappers/dashboard-server-nohup.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mitchellwilliams</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <false/>

    <!-- Crucial on macOS Tahoe: prevents launchd from killing the nohup'd
         child process when the wrapper script (this job's "program") exits.
         Without this, the spawned dashboard-server gets reaped at script
         end-of-life along with the bash parent. Discovered 2026-05-21. -->
    <key>AbandonProcessGroup</key>
    <true/>

    <!-- Recovery cadence: re-run script every 5 minutes. Script is idempotent
         (no-ops if port 3097 is already bound), so this only takes action when
         the dashboard-server has died. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- Log path MUST live outside ~/Documents/ — macOS Tahoe TCC blocks
         launchd from writing to log files under Documents (silent EX_CONFIG=78).
         Fixed 2026-05-22 (Phase 6.5-CAD-1) — same root cause as Pattern F,
         applies to wrapper plists too. -->
    <key>StandardOutPath</key>
    <string>/Users/mitchellwilliams/Library/Logs/career-ops/dashboard-server-nohup-wrapper.out</string>

    <key>StandardErrorPath</key>
    <string>/Users/mitchellwilliams/Library/Logs/career-ops/dashboard-server-nohup-wrapper.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/mitchellwilliams/.nvm/versions/node/v24.14.0/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/mitchellwilliams</string>
    </dict>
</dict>
</plist>
