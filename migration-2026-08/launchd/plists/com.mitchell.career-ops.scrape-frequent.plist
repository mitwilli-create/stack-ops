<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mitchell.career-ops.scrape-frequent</string>

        <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>export NVM_DIR=&quot;$HOME/.nvm&quot;; [ -s &quot;$NVM_DIR/nvm.sh&quot; ] &amp;&amp; . &quot;$NVM_DIR/nvm.sh&quot;; exec node &apos;/Users/mitchellwilliams/Documents/career-ops/scripts/launchd-wrapper.mjs&apos; &apos;--label=com.mitchell.career-ops.scrape-frequent&apos; &apos;--max-retries=0&apos; &apos;--retry-backoff-sec=60&apos; &apos;--&apos; &apos;node&apos; &apos;/Users/mitchellwilliams/Documents/career-ops/scripts/scrape-only.mjs&apos;</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mitchellwilliams/Documents/career-ops</string>

    <!-- Every 4 hours. Council/dealbreaker 2026-05-19 verdict on Impasse 1:
         every-4h captures the 24-48h first-mover window; hourly only buys <5%
         incremental at 2x cost. Greenhouse boards-api is unrate-limited;
         Ashby is ~100/min — neither is a constraint at our scale. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <!-- Tahoe Sandbox fix (2026-05-21): macOS xpcproxy can't write to plist
         StandardOut/ErrorPath under ~/Documents/ (Sandbox System Policy
         deny(1) file-read-data on xpcproxy). Symptom: spawn fails with
         exit code 78 EX_CONFIG, runs=1 forever, dated `data/logs/scrape-*.log`
         files stop updating. Same bug-class as Pattern F (~/.claude/knowledge/
         brain/bug-class-catalog.md § launchd-keepalive-tahoe) but for one-shot
         StartCalendarInterval jobs. Fix: move stdout/stderr OUTSIDE ~/Documents/.
         The script itself (scripts/scrape-only.mjs) stays in Documents because
         it's invoked via NODE_BIN (already TCC-granted), not /bin/bash. -->
    <key>StandardOutPath</key>
    <string>/Users/mitchellwilliams/Library/Logs/career-ops/scrape-frequent-launchd.out</string>

    <key>StandardErrorPath</key>
    <string>/Users/mitchellwilliams/Library/Logs/career-ops/scrape-frequent-launchd.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/mitchellwilliams/.nvm/versions/node/v24.14.0/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/mitchellwilliams</string>
    </dict>
</dict>
</plist>
