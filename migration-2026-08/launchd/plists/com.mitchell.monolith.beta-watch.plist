<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mitchell.monolith.beta-watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>export NVM_DIR="$HOME/.nvm"; [ -s "$NVM_DIR/nvm.sh" ] &amp;&amp; . "$NVM_DIR/nvm.sh"; exec node '/Users/mitchellwilliams/Documents/monolith/.claude/beta-watch/watch.mjs'</string>
    </array>

    <!-- NOT under ~/Documents — Tahoe TCC denies launchd getcwd there; the
         script uses absolute paths and never needs the repo as cwd. -->
    <key>WorkingDirectory</key>
    <string>/Users/mitchellwilliams</string>

    <!-- Wednesday 07:23 PT — weekly beta watch; invites expected to go out on a
         Wednesday, so each run covers a whole invite-anniversary week. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>3</integer>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>23</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <!-- Log path MUST live outside ~/Documents/ — macOS Tahoe TCC blocks
         launchd log writes under Documents (bug-class catalog, Tahoe pattern). -->
    <key>StandardOutPath</key>
    <string>/Users/mitchellwilliams/Library/Logs/monolith/beta-watch.out</string>

    <key>StandardErrorPath</key>
    <string>/Users/mitchellwilliams/Library/Logs/monolith/beta-watch.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/mitchellwilliams/.nvm/versions/node/v24.14.0/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/mitchellwilliams</string>
    </dict>
</dict>
</plist>
