diff --git a/lib/council.mjs b/lib/council.mjs
index 96c698d6..7c9df283 100644
--- a/lib/council.mjs
+++ b/lib/council.mjs
@@ -166,46 +166,151 @@ export const RESEARCH_COUNCIL_LINEUPS = {
 // Add a new archetype by extending this table — callers do not need to know
 // which vendor wins; they pass `opts.taskType: '<archetype>'` and routing
 // resolves at call time.
+// Sentinel for archetypes that are MEDIA tasks and must be answered by
+// MEDIA_ROUTER_MATRIX via routeMedia(), never by this text matrix. Using a
+// sentinel rather than deleting the rows keeps the archetype names valid and
+// gives callers an actionable error instead of a silently wrong text model.
+export const MEDIA_DELEGATED = Object.freeze({ __delegateTo: 'MEDIA_ROUTER_MATRIX' });
+
+// TWO TABLES, DELIBERATELY SEPARATE (2026-07-19). Read this before editing either.
+//
+// TASK_ROUTING_MATRIX values are a FAN-OUT lineup: callCouncil() sends the prompt
+// "verbatim to every model" in the array. So a multi-entry row here means paying
+// N models for one answer. Every row below is therefore a SINGLE pick — the one
+// model that should serve a one-shot call of that archetype. Adding a second
+// entry to a row multiplies its cost; do not do it to express a fallback.
+//
+// TASK_ROUTING_LADDERS (below) is where cheap-first fallback lives: an ordered
+// chain walked ONE AT A TIME by the `cheap` CLI and the Decision-A pipeline
+// (open-weight draft → automated gate → frontier reviews only the hard deltas).
+// Walking a ladder costs one model at a time; fanning out costs all of them.
+//
+// PRINCIPLE: route by the WINNING MODEL, never the brand — and never by
+// reputation either. Live pricing (2026-07-19) showed the nominally "cheap"
+// open-weight names (GLM-5.2, Kimi) cost 10x the real floor. See
+// 'openrouter:toil'.
+//
+// KNOWN GAP, deliberately not fixed here: the model IDs INSIDE each PROVIDERS
+// entry are still a generation behind in places (opus-4-7 vs opus-4-8, sonnet-4-6
+// vs sonnet-5, grok-4 vs grok-4.5, gpt-5 vs gpt-5.6, gemini-2.5 vs 3.x). The keys
+// below are stable handles; unstaling what each one dispatches to is a separate
+// change with a much larger blast radius across this file's callers. Do that as
+// its own pass, verifying each ID against the provider.
 export const TASK_ROUTING_MATRIX = {
-  // Long-form research with native citations — Perplexity Sonar Pro
+  // Long-form research with native citations. No cheap tier: the value IS the
+  // retrieval index, which open-weight models do not have.
   'long_form_research':         ['perplexity:sonar-pro'],
-  // Multi-file code refactor — Opus 4.7 (highest reasoning + tool-use depth)
-  'code_refactor_multifile':    ['anthropic:claude-opus-4-7'],
-  // Structured JSON extraction — Sonnet 4.6 (cost-effective, reliable JSON)
