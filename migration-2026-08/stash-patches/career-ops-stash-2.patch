@@ -0,0 +1,99 @@
+/**
+ * providers/teamtailor.mjs — Teamtailor ATS provider for scan.mjs.
+ *
+ * Added 2026-07-27 while fixing 14 dead boards. Lindy's board had been
+ * configured as Ashby (`jobs.ashbyhq.com/lindy`), which 404s — they are
+ * actually on Teamtailor at `lindy.na.teamtailor.com`. Without a provider for
+ * it there was no way to express that in portals.yml, so the company would
+ * have stayed unsearched no matter how the entry was written.
+ *
+ * Careful: a plain-name slug guess is dangerous here. `recruitee.com/lindy`
+ * resolves to Lindy Elektronik, a German office-products company whose board
+ * is full of Mannheim sales roles. Board URLs must come from the company's own
+ * careers page, never from a name guess. The Teamtailor subdomain carries a
+ * REGION segment (`na.`, `eu.`) that is part of the address, which is why this
+ * matches the full host rather than reconstructing it from a slug.
+ *
+ * Feed: https://{sub}.{region}.teamtailor.com/jobs.json
+ * JSON Feed v1 shape:
+ *   { version, title, items: [{ id, title, url, date_published, content_html,
+ *     _jobposting: { jobLocation: [{ address: { addressLocality, ... } }] } }] }
+ *
+ * Provider contract:
+ *   id: 'teamtailor'
+ *   detect(entry): {url} | null
+ *   fetch(entry, ctx): [{title, url, company, location}]
+ */
+
+import { makeHttpCtx } from './_http.mjs';
+
+// Host, including the region segment when present: lindy.na.teamtailor.com
+// Anchored, and matched against a parsed hostname rather than raw URL text —
+// a loose match would accept teamtailor-looking strings appearing anywhere in
+// a URL (a query parameter, a path segment on someone else's domain).
+const TEAMTAILOR_HOST_RE = /^(?:[a-z0-9-]+\.){1,2}teamtailor\.com$/i;
+
+function extractHost(entry) {
+  for (const url of [entry.api || '', entry.careers_url || '']) {
+    if (!url) continue;
+    try {
+      const host = new URL(url).hostname.toLowerCase();
+      if (TEAMTAILOR_HOST_RE.test(host)) return host;
+    } catch {
+      // Not a parseable URL — try the next configured field.
+    }
+  }
+  return null;
+}
+
+function buildFeedUrl(host) {
+  return `https://${host}/jobs.json`;
+}
+
+/** Pull a readable location out of the embedded schema.org JobPosting. */
+function locationOf(item) {
+  const places = item?._jobposting?.jobLocation;
+  if (!Array.isArray(places) || !places.length) return '';
+  const parts = places
+    .map(p => {
+      const a = p?.address || {};
+      return [a.addressLocality, a.addressRegion, a.addressCountry].filter(Boolean).join(', ');
+    })
+    .filter(Boolean);
+  return [...new Set(parts)].join(' / ');
+}
+
+const teamtailor = {
+  id: 'teamtailor',
+
+  detect(entry) {
+    const host = extractHost(entry);
+    return host ? { url: buildFeedUrl(host) } : null;
+  },
+
+  async fetch(entry, ctx = makeHttpCtx()) {
+    const host = extractHost(entry);
+    if (!host) throw new Error(`teamtailor: cannot determine board host for "${entry.name}"`);
+    const company = entry.name || 'Unknown';
+    const url = buildFeedUrl(host);
+
+    const res = await ctx.fetch(url, {
+      signal: AbortSignal.timeout(ctx.timeoutMs || 8000),
+      headers: { ...ctx.headers, 'Accept': 'application/json' },
+    });
+    if (!res.ok) throw new Error(`teamtailor: HTTP ${res.status} from ${url}`);
+
+    const data = await res.json();
+    const items = Array.isArray(data?.items) ? data.items : [];
+    return items
+      .filter(it => it && it.title && it.url)
+      .map(it => ({
+        title: it.title,
+        url: it.url,
+        company,
+        location: locationOf(it),
+      }));
+  },
+};
+
+export default teamtailor;
