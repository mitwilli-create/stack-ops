+// ── Transient-safe SMTP send ───────────────────────────────────────────────
+// A stalled Gmail send hung ~208s before dying with "read ECONNRESET" on
+// 2026-07-17, failing the whole evening digest (the launchd wrapper runs
+// max-retries=0). Two guards, deliberately conservative about duplicates:
+//   1. The createTransport timeouts below bound each attempt so a wedged
+//      socket fails fast instead of hanging for minutes.
+//   2. sendMailWithRetry retries ONLY failures that provably happened BEFORE
+//      the SMTP server accepted the message. A mid-stream reset (ECONNRESET),
+//      socket timeout, or EPIPE can fire AFTER Gmail has queued the mail but
+//      before Nodemailer reads the 250 OK, so retrying those would risk a
+//      DUPLICATE digest (CodeRabbit, PR #470). Connection / DNS / refused
+//      failures occur before any DATA is transmitted and are safe to retry.
+// Everything else — including the observed ECONNRESET — still throws →
+// main().catch → exit 1, so fleet-watchdog still alarms on a real delivery
+// outage (exit 1 is deliberately NOT a registered expected exit).
+const RETRYABLE_PRE_SEND_CODES = new Set([
+  'ECONNECTION',   // Nodemailer: connection could not be established
+  'EDNS',          // DNS lookup failed
+  'ENOTFOUND',     // DNS: host not found
+  'EAI_AGAIN',     // DNS: temporary failure, try again
+  'ECONNREFUSED',  // server refused the connection
+]);
+function isRetryablePreSendError(err) {
+  // Code-based only: message/regex matching can't reliably tell a connect-phase
+  // stall from a data-phase one, and a false positive here means a duplicate.
+  return !!(err && err.code && RETRYABLE_PRE_SEND_CODES.has(err.code));
+}
+async function sendMailWithRetry(transporter, message, { attempts = 3, baseDelayMs = 3000 } = {}) {
+  let lastErr;
+  for (let attempt = 1; attempt <= attempts; attempt++) {
+    try {
+      return await transporter.sendMail(message);
+    } catch (err) {
+      lastErr = err;
+      if (attempt === attempts || !isRetryablePreSendError(err)) throw err;
+      const delayMs = baseDelayMs * attempt;
+      console.warn(`[heartbeat-evening] retryable pre-send SMTP error (${err.code}); retry ${attempt}/${attempts - 1} in ${delayMs}ms`);
+      await new Promise(resolve => setTimeout(resolve, delayMs));
+    }
+  }
+  throw lastErr; // defensive: the loop always returns or throws above
+}
+
