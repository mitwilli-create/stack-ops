--- a/tests/unit/dashboard-weight-budget.test.mjs
+++ b/tests/unit/dashboard-weight-budget.test.mjs
@@ -3,21 +3,67 @@ import test from 'node:test';
 
 import { dashboardWeightBudget } from '../../lib/dashboard-weight-budget.mjs';
 
-test('dashboard weight budget preserves the original baseline ceiling', () => {
