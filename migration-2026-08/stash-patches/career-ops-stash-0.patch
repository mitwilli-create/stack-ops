diff --git a/lib/dashboard-weight-budget.mjs b/lib/dashboard-weight-budget.mjs
index c3646b93..20146c0a 100644
--- a/lib/dashboard-weight-budget.mjs
+++ b/lib/dashboard-weight-budget.mjs
@@ -1,20 +1,45 @@
-const BASELINE_EVALUATIONS = 180;
-const BASE_WARN_BYTES = 12 * 1024 * 1024;
-const BASE_FAIL_BYTES = 15 * 1024 * 1024;
-const BYTES_PER_ADDITIONAL_EVALUATION = 12 * 1024;
+// Dashboard build-weight budget.
+//
+// The gate exists to catch the inline-payload-bloat bug class (bug-class-catalog
+// entry 3): contacts.json / pill-data.json / wave-cb.json getting baked into
+// index.html instead of served from /data. Those regressions are 2.4-3.6 MB
+// events, so the gate only needs to resolve deltas of roughly that size.
+//
+// CALIBRATION (2026-07-27). The previous model was `15 MB base + 12 KB per
+// evaluation past 180`. Both halves were wrong in opposite directions: the base
+// was ~2x more generous than reality, and the per-evaluation slope was less than
+// half the true marginal cost. The loose base masked the shallow slope until the
+// two lines crossed at ~687 evaluations, at which point a clean build with no
+// regression at all started failing the gate. Observed minified weights:
+//
+//   195 evaluations -> 7,421,581 bytes   (.claude/audit/closure-08-2026-05-22)
+//   710 evaluations -> 22,631,259 bytes  (proc-ms3ugjrl-b7046c, 2026-07-27)
+//
+// Fitting a line through those two points gives 29,533 bytes per evaluation and
+// a 1,662,646-byte fixed cost (chrome, inline scripts, styles). That model
+// predicts the 710-evaluation build to within 183 bytes, so per-evaluation cost
+// is stable enough to gate on a tight percentage band rather than a flat ceiling.
+//
+// The band is set so the smallest documented regression still trips it: baking
+// contacts.json back inline adds ~2.36 MB, which is +10.4% at 710 evaluations.
+// Hence fail at +10%. Warn at +5% to surface drift a build before it blocks.
+const BASE_BYTES = 1_662_646;
+const BYTES_PER_EVALUATION = 29_533;
+const WARN_TOLERANCE = 0.05;
+const FAIL_TOLERANCE = 0.10;
 
 export function dashboardWeightBudget(evaluationCount) {
   if (!Number.isSafeInteger(evaluationCount) || evaluationCount < 0) {
     throw new TypeError('evaluationCount must be a non-negative integer');
   }
-  const additionalEvaluations = Math.max(
-    0,
-    evaluationCount - BASELINE_EVALUATIONS,
-  );
-  const growthAllowance =
-    additionalEvaluations * BYTES_PER_ADDITIONAL_EVALUATION;
-  return {
-    warnBytes: BASE_WARN_BYTES + growthAllowance,
-    failBytes: BASE_FAIL_BYTES + growthAllowance,
-  };
+  const expectedBytes = BASE_BYTES + evaluationCount * BYTES_PER_EVALUATION;
+  const warnBytes = Math.round(expectedBytes * (1 + WARN_TOLERANCE));
+  const failBytes = Math.round(expectedBytes * (1 + FAIL_TOLERANCE));
+  // evaluationCount alone can be a safe integer while the derived budget is not.
+  // Silently returning an imprecise ceiling would make the gate compare against
+  // a number that does not mean what it says, so fail loudly instead.
+  if (![expectedBytes, warnBytes, failBytes].every(Number.isSafeInteger)) {
+    throw new RangeError('evaluationCount produces an unsafe byte budget');
+  }
+  return { expectedBytes, warnBytes, failBytes };
 }
