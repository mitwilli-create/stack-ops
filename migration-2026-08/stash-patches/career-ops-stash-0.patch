+test('gate still catches the smallest documented inline-payload regression', () => {
+  const CONTACTS_JSON_BYTES = 2_363_519;
+  const { evaluations, observedBytes } = ANCHORS[1];
+  const { failBytes } = dashboardWeightBudget(evaluations);
+
+  assert.ok(
+    observedBytes + CONTACTS_JSON_BYTES > failBytes,
+    `re-inlining contacts.json must fail the gate (would be ${observedBytes + CONTACTS_JSON_BYTES}, ceiling ${failBytes})`,
+  );
+});
 
-  assert.ok(budget.failBytes > 19_033_534);
-  assert.ok(budget.failBytes < 21 * 1024 * 1024);
-  assert.equal(
