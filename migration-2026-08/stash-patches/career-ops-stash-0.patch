+// Calibration anchors: real minified weights from two builds two months apart.
+// See lib/dashboard-weight-budget.mjs for provenance.
+const ANCHORS = [
+  { evaluations: 195, observedBytes: 7_421_581 },
+  { evaluations: 710, observedBytes: 22_631_259 },
+];
+
+test('budget model predicts observed builds to within 1%', () => {
+  for (const { evaluations, observedBytes } of ANCHORS) {
+    const { expectedBytes } = dashboardWeightBudget(evaluations);
+    const drift = Math.abs(expectedBytes - observedBytes) / observedBytes;
+    assert.ok(
+      drift <= 0.01,
+      `${evaluations} evaluations: predicted ${expectedBytes}, observed ${observedBytes} (${(drift * 100).toFixed(2)}% drift)`,
+    );
+  }
+});
+
+test('a clean build at the observed weight passes the gate', () => {
+  for (const { evaluations, observedBytes } of ANCHORS) {
+    const { failBytes, warnBytes } = dashboardWeightBudget(evaluations);
+    assert.ok(
+      observedBytes < warnBytes,
+      `${evaluations} evaluations: clean build ${observedBytes} should not even warn (warn at ${warnBytes})`,
+    );
+    assert.ok(observedBytes < failBytes);
+  }
 });
 
-test('dashboard weight budget allows bounded growth for rendered evaluations', () => {
-  const budget = dashboardWeightBudget(584);
